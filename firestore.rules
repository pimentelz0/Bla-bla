rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }
    match /messages/{messageId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
